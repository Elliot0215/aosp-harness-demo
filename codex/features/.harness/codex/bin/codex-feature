#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
DEFAULT_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd -P)"
ROOT="${HARNESS_ROOT:-$DEFAULT_ROOT}"

dry_run=0
if [[ "${1:-}" == '--dry-run' ]]; then
  dry_run=1
  shift
fi

HARNESS_ROOT="$ROOT" "$SCRIPT_DIR/prepare-feature"
if [[ "$dry_run" -eq 1 ]]; then
  exit 0
fi

cd "$ROOT"
exec codex "$@"
